<%- include('partials/head') %>
<div class="pagehead"><div><h1>Hola, <%= user.name.split(' ')[0] %></h1><p class="sub">Tu progreso en el Programa de Aprendizaje Registrado</p></div>
  <div><a class="btn ghost" href="/messages/new">Escribir a Portilla Law</a></div></div>
<div class="grid g4">
  <div class="card"><%- include('partials/gauge', { pct: progress.pct, label: 'Entrenamientos completados' }) %></div>
  <div class="stat"><b><%= progress.completedHours %>/<%= progress.target %></b><span>Horas completadas</span></div>
  <div class="stat"><b><%= progress.attendancePct %>%</b><span>Asistencia</span></div>
  <div class="stat"><b><%- progress.inCompliance ? '<span style="color:#1b7f4b">✔</span>' : '<span style="color:#b42318">⚠</span>' %></b><span><%= progress.inCompliance ? 'En cumplimiento' : 'Requiere atención — comunícate con Portilla Law' %></span></div>
</div>
<div class="card">
  <h2>Próximos entrenamientos</h2>
  <% upcoming.forEach(function(a){ %><%- include('partials/assignment_card', { a: a }) %><% }) %>
  <% history.filter(a => a.status === 'pendiente_reporte').forEach(function(a){ %><%- include('partials/assignment_card', { a: a }) %><% }) %>
  <% if (!upcoming.length && !history.some(a => a.status === 'pendiente_reporte')) { %><p class="muted">No tienes entrenamientos pendientes.</p><% } %>
</div>
<div class="card">
  <h2>Historial</h2>
  <div class="tablewrap"><table><tr><th>Fecha</th><th>Entrenamiento</th><th>Estado</th><th>Horas</th></tr>
  <% history.forEach(function(a){ %><tr><td class="nowrap"><%= fmt(a.starts_at) %></td><td><%= a.title %></td><td><span class="pill <%= a.status %>"><%= STATUS_LABELS[a.status] %></span></td><td><%= a.status === 'completado' ? a.hours_credit : 0 %></td></tr><% }) %>
  <% if (!history.length) { %><tr><td colspan="4" class="muted">Sin historial todavía.</td></tr><% } %></table></div>
</div>
<%- include('partials/foot') %>

<%- include('partials/head') %>
<h1>Nuevo mensaje</h1>
<form method="post" action="/messages" class="card" style="max-width:760px">
  <label>Para</label>
  <select name="to" id="to" multiple size="8">
    <% contacts.forEach(function(c){ %><option value="<%= c.id %>" <%= to === c.id ? 'selected' : '' %>><%= c.name %> — <%= ROLE_LABELS[c.role] %><%= c.company_name ? ' · ' + c.company_name : '' %></option><% }) %>
  </select>
  <div class="small muted">Ctrl/Cmd + clic para seleccionar varios.</div>
  <% if (groups.length) { %>
    <label>…o enviar a un grupo</label>
    <select name="group"><option value="">— Ninguno —</option><% groups.forEach(function(g){ %><option value="<%= g.key %>"><%= g.label %></option><% }) %></select>
  <% } %>
  <label>Asunto</label><input name="subject" value="<%= reply ? 'Re: ' + (reply.subject || '') : '' %>">
  <label>Mensaje</label><textarea name="body" required style="min-height:160px"></textarea>
  <label class="check"><input type="checkbox" name="also_email" checked> Enviar también por email</label>
  <label class="check"><input type="checkbox" name="also_sms"> Enviar también por SMS</label>
  <button class="btn mt">Enviar</button>
</form>
<%- include('partials/foot') %>

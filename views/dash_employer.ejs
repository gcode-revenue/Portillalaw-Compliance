<%- include('partials/head') %>
<div class="pagehead">
  <div><h1><%= company ? company.name : 'Mi empresa' %></h1><p class="sub">Progreso y cumplimiento de sus empleados en el Programa de Aprendizaje Registrado</p></div>
  <div class="noprint">
    <a class="btn" href="/users/new?role=employee">+ Añadir empleado</a>
    <% if (company) { %><a class="btn ghost" href="/reports/weekly/<%= company.id %>">Reporte semanal</a><% } %>
    <a class="btn ghost" href="/messages/new">Escribir a Portilla Law</a>
  </div>
</div>
<div class="grid g4">
  <div class="card"><%- include('partials/gauge', { pct: prog.avg, label: 'Progreso promedio' }) %></div>
  <div class="stat"><b><%= prog.total %></b><span>Empleados</span></div>
  <div class="stat"><b style="color:#1b7f4b"><%= prog.compliant %></b><span>En cumplimiento</span></div>
  <div class="stat"><b style="color:<%= prog.openAlerts ? '#b42318' : '#1b7f4b' %>"><%= prog.openAlerts %></b><span>Alertas abiertas</span></div>
</div>
<% if (alerts.length) { %>
<div class="card"><h2>⚠️ Requiere su atención</h2>
  <% alerts.forEach(function(a){ %><div class="alert-item"><%= a.message %> <span class="muted small">· <%= fmt(a.created_at) %></span> · <a class="small" href="/messages/new?to=<%= a.employee_id %>">Escribirle</a></div><% }) %>
</div>
<% } %>
<div class="card">
  <h2>Empleados</h2>
  <div class="tablewrap"><table>
    <tr><th>Empleado</th><th>Progreso</th><th>Horas</th><th>Asistencia</th><th>Estado</th></tr>
    <% prog.employees.forEach(function(e){ %>
    <tr><td><a href="/employees/<%= e.id %>"><%= e.name %></a><div class="small muted"><%= e.job_title || '' %></div></td>
      <td style="min-width:160px"><%- include('partials/bar', { pct: e.progress.pct }) %></td>
      <td><%= e.progress.completedHours %>/<%= e.progress.target %></td><td><%= e.progress.attendancePct %>%</td>
      <td><%- e.progress.inCompliance ? '<span class="pill okc">En cumplimiento</span>' : '<span class="pill badc">Requiere atención</span>' %></td></tr>
    <% }) %>
    <% if (!prog.employees.length) { %><tr><td colspan="5" class="muted">No hay empleados registrados.</td></tr><% } %>
  </table></div>
</div>
<div class="card"><h2>Próximos entrenamientos</h2>
  <% upcoming.forEach(function(t){ %><div><a href="/trainings/<%= t.id %>"><%= t.title %></a> · <%= fmt(t.starts_at) %> · <%= MODALITY_LABELS[t.modality] %></div><% }) %>
  <% if (!upcoming.length) { %><p class="muted">No hay entrenamientos programados.</p><% } %>
</div>
<%- include('partials/foot') %>

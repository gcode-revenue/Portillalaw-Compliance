<% const bp = Math.max(0, Math.min(100, Number(pct) || 0)); %>
<div style="display:flex;align-items:center;gap:.5rem"><div class="bar" style="flex:1"><i style="width:<%= bp %>%;background:<%= bp >= 80 ? '#1b7f4b' : bp >= 50 ? '#c98a00' : '#b42318' %>"></i></div><b class="small"><%= bp %>%</b></div>

<%- include('partials/head') %>
<div class="pagehead">
  <div><h1><%= t.title %> <% if (t.cancelled) { %><span class="pill ausente">Cancelado</span><% } %></h1>
    <p class="sub"><%= fmt(t.starts_at) %> · <%= MODALITY_LABELS[t.modality] %> · <%= t.duration_min %> min · <%= t.hours_credit %> h crédito · <%= t.company_name || 'Varias compañías' %></p></div>
  <% if (isStaff && !t.cancelled) { %><div class="noprint"><a class="btn ghost" href="/trainings/<%= t.id %>/edit">Editar</a>
    <form class="inline" method="post" action="/trainings/<%= t.id %>/cancel" onsubmit="return confirm('¿Cancelar este entrenamiento y notificar a los participantes?')"><button class="btn bad">Cancelar</button></form></div><% } %>
</div>
<div class="grid g2">
  <div class="card"><h2>Detalles</h2>
    <% if (t.description) { %><p class="msgbody"><%= t.description %></p><% } %>
    <div class="small"><b>Instructor:</b> <%= t.instructor || '—' %></div>
    <% if (t.location) { %><div class="small"><b>Lugar:</b> <%= t.location %></div><% } %>
    <% if (t.meeting_url) { %><div class="small"><b>Enlace:</b> <a href="<%= t.meeting_url %>" target="_blank" rel="noopener"><%= t.meeting_url %></a></div><% } %>
    <% if (t.modality === 'video') { %><div class="small"><b>Disponible:</b> <%= fmt(t.starts_at) %> · <b>Fecha límite:</b> <%= fmt(t.due_at) %> · mínimo <%= videoMinPct %>% visto</div><% } %>
    <% if (zoomInfo) { %><div class="small"><b>Asistencia automática Zoom:</b>
      <% if (!zoomInfo.configured) { %><span class="muted">Zoom no conectado</span>
      <% } else if (!zoomInfo.meetingId) { %><span class="muted">sin ID de reunión</span>
      <% } else { %>reunión <%= zoomInfo.meetingId %> · <%= zoomInfo.sync && zoomInfo.sync.synced_at ? 'importado ' + fmt(zoomInfo.sync.synced_at) + ' (' + zoomInfo.sync.participants + ' participantes)' : (zoomInfo.sync && zoomInfo.sync.error ? zoomInfo.sync.error : 'se importará al terminar') %>
        <% if (isStaff) { %><form class="inline" method="post" action="/trainings/<%= t.id %>/zoom-sync"><button class="btn sm ghost">Importar ahora</button></form><% } %><% } %></div><% } %>
    <% if (t.modality !== 'video') { %><div class="small"><b>Ventana de check-in:</b> <%= fmt(new Date(window.open).toISOString()) %> – <%= fmt(new Date(window.close).toISOString()) %> <%= window.isOpen ? '🟢 abierta' : '' %></div><% } %>
  </div>
  <% if (isStaff && !t.cancelled) { %>
  <div class="card"><h2>Asignar empleados</h2>
    <% if (candidates.length) { %>
    <form method="post" action="/trainings/<%= t.id %>/assign">
      <div style="max-height:220px;overflow:auto;border:1px solid var(--line);border-radius:7px;padding:.4rem">
        <label class="check"><input type="checkbox" onclick="document.querySelectorAll('.cand').forEach(c=>c.checked=this.checked)"> <b>Seleccionar todos</b></label>
        <% candidates.forEach(function(c){ %><label class="check"><input class="cand" type="checkbox" name="employee_ids" value="<%= c.id %>"> <%= c.name %> <span class="muted small">&nbsp;· <%= c.company_name %></span></label><% }) %>
      </div>
      <button class="btn mt">Asignar y notificar</button>
    </form>
    <% } else { %><p class="muted">Todos los empleados elegibles ya están asignados.</p><% } %>
  </div>
  <% } %>
</div>
<div class="card"><h2>Lista de participantes y asistencia</h2>
  <div class="tablewrap"><table>
  <tr><th>Empleado</th><th>Estado</th><th>Checklist de confirmación</th><% if (user.role !== 'employee') { %><th class="noprint">Acciones</th><% } %></tr>
  <% roster.forEach(function(a){ %>
  <tr><td><% if (user.role !== 'employee') { %><a href="/employees/<%= a.employee_id %>"><%= a.emp_name %></a><% } else { %><%= a.emp_name %><% } %><div class="small muted"><%= a.company_name %> <%= a.phone ? '· ' + a.phone : '' %></div>
      <% if (a.notes) { %><div class="small msgbody muted"><%= a.notes %></div><% } %></td>
    <td><span class="pill <%= a.status %>"><%= STATUS_LABELS[a.status] %></span>
      <% if (t.modality === 'video') { %><div style="margin-top:.4rem;min-width:120px"><%- include('partials/bar', { pct: a.video_pct || 0 }) %></div><% if (a.video_seen_at) { %><div class="small muted">Última actividad <%= fmt(a.video_seen_at) %></div><% } %><% } %>
      <% if (a.attended_minutes && t.modality !== 'video') { %><div class="small muted"><%= a.attended_minutes %> min conectado</div><% } %></td>
    <td><%- include('partials/checklist', { items: a.checklist }) %></td>
    <% if (user.role !== 'employee') { %><td class="noprint"><%- include('partials/assignment_actions', { a: a }) %></td><% } %></tr>
  <% }) %>
  <% if (!roster.length) { %><tr><td colspan="4" class="muted">Sin participantes asignados.</td></tr><% } %>
  </table></div>
</div>
<%- include('partials/foot') %>

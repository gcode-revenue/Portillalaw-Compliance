<%- include('partials/head') %>
<div class="login">
  <div class="brandbig">⚖️ <%= orgName %></div>
  <p class="muted" style="text-align:center;margin-top:0">Plataforma de Cumplimiento · Programa de Aprendizaje Registrado</p>
  <div class="card">
    <% if (error) { %><div class="flash error"><%= error %></div><% } %>
    <form method="post" action="/login">
      <input type="hidden" name="next" value="<%= next %>">
      <label>Correo electrónico</label><input name="email" type="email" value="<%= email %>" required autofocus>
      <label>Contraseña</label><input name="password" type="password" required>
      <button class="btn mt" style="width:100%">Entrar</button>
    </form>
  </div>
</div>
<%- include('partials/foot') %>

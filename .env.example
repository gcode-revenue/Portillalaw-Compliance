# Copie este archivo como .env y complete los valores.
PORT=3000
APP_URL=https://cumplimiento.portillalaw.com   # URL pública (se usa en enlaces de email/SMS)
APP_SECRET=cambie-esto-por-una-cadena-larga-y-aleatoria
COOKIE_SECURE=true                             # true en producción (HTTPS)
APP_TZ=America/Puerto_Rico
# DB_PATH=./data/portilla.db

# Email — Microsoft 365 vía Microsoft Graph (recomendado; ver DEPLOY.md)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER=cumplimiento@portillalaw.com
# Email — alternativa SMTP genérica (sólo si no usa Microsoft Graph)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Portilla Law Cumplimiento <cumplimiento@portillalaw.com>"

# SMS — Heymarket (Settings > Integrations > API)
HEYMARKET_SECRET_ID=
HEYMARKET_SECRET_KEY=
HEYMARKET_INBOX_ID=
HEYMARKET_CREATOR_ID=
HEYMARKET_WEBHOOK_TOKEN=una-cadena-aleatoria
# SMS — alternativa Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=aviso_portilla
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=una-cadena-aleatoria

# Cuenta del presidente (se crea en el primer arranque si no hay usuarios)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# Zoom: asistencia automática (app Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
